FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-eng ffmpeg poppler-utils fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir Pillow==12.3.0 jsonschema==4.26.0 pypdfium2==5.14.0
ENV PYTHONPATH=/code/src PYTHONDONTWRITEBYTECODE=1
WORKDIR /work
USER 10001:10001
ENTRYPOINT ["python", "-m", "homelab_vision.cli"]
